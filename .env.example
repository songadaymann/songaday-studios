# Cloudflare authentication is managed by Wrangler, outside this repository.

# For `wrangler dev`, copy these to .dev.vars (`cp .env.example .dev.vars`) and fill them in.
# .dev.vars values override the "vars" in wrangler.jsonc. Never commit .dev.vars.

# Turnstile. Locally, use Cloudflare's always-pass test keys:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# In production the site key is in wrangler.jsonc and the secret is set with
# `wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Song commissions (songaday.studio/commission; README, "Commissions").
# "open" takes requests; anything else shows "Requests open soon."
COMMISSION_REQUESTS=open
# Links in emails and Stripe's return addresses. Match the port wrangler dev uses.
SITE_ORIGIN=http://localhost:8787
# Leave both empty locally: the admin then works on localhost without Cloudflare Access.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# A Stripe TEST-mode restricted key (rk_test_...), for paying locally. Optional: without it the
# pay form says payments aren't set up yet. Production: `wrangler secret put STRIPE_SECRET_KEY`.
STRIPE_SECRET_KEY=
# The whsec_... that `stripe listen --latest --forward-to localhost:8787/commission/stripe`
# prints. Production: `wrangler secret put STRIPE_WEBHOOK_SECRET` with the endpoint's secret.
STRIPE_WEBHOOK_SECRET=
# Addresses allowed into /commission/admin once Access is set up, comma-separated. A secret only
# so Jonathan's address stays out of the public repo. Production: `wrangler secret put ADMIN_EMAILS`.
ADMIN_EMAILS=

# Optional, for fumble-approve.mjs: the Codex binary that paints. Defaults to the copy inside
# the ChatGPT app when it's installed, then `codex` on your PATH.
CODEX_BIN=

# Optional, for build-calendar.mjs: the folder of 480×270 song stills (<number>.webp) that
# songaday-display builds, e.g. ~/Library/Caches/songaday-display/publish/stills. You can
# pass the folder as an argument instead.
STILLS_DIR=
